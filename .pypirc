[distutils]
index-servers =
    pypi
    testpypi

[pypi]
repository = https://upload.pypi.org/legacy/
username = __token__
password = # PASTE YOUR PYPI API TOKEN HERE (starting with pypi-)

[testpypi]
repository = https://test.upload.pypi.org/legacy/
username = __token__
password = # PASTE YOUR TEST PYPI API TOKEN HERE (starting with pypi-)
