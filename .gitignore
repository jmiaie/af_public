sandbox_workspace/
namespace_workspace/
docker_workspace/
vault/
.env
.env.*
!.env.example

# Personal / agent session notes — keep these out of the public repo
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*.md
*_Identity_File.md
PYPI_SETUP.md
